{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "check": "node scripts/run-checks.mjs",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:e2e:api": "tsx scripts/e2e/guest-order-flow.ts",
    "skills:sync": "node scripts/sync-mattpocock-skills.mjs",
    "po:audit": "node scripts/po-audit.mjs",
    "seo:gen": "node scripts/gen-seo-files.mjs",
    "seo:check": "node scripts/gen-seo-files.mjs --check --allow-empty",
    "machine:next": "node scripts/machine-next.mjs",
    "guard:max-lines": "node scripts/check-max-lines.mjs",
    "guard:any-budget": "node scripts/check-any-budget.mjs",
    "guard:import-boundaries": "node scripts/check-import-boundaries.mjs",
    "guard:import-cycles": "node scripts/check-import-cycles.mjs",
    "guard:all": "npm run guard:max-lines && npm run guard:any-budget && npm run guard:import-boundaries && npm run guard:import-cycles",
    "guard:update": "node scripts/check-max-lines.mjs --update && node scripts/check-any-budget.mjs --update && node scripts/check-import-boundaries.mjs --update",
    "db:check": "node scripts/db-query.mjs --check",
    "db:query": "node scripts/db-query.mjs",
    "mcp:supabase": "node scripts/supabase-mcp-proxy.mjs",
    "catalog:import": "node scripts/import-catalog.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.114.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "occt-import-js": "^0.0.23",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.2",
    "three": "^0.185.1",
    "vite": "^6.2.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.185.4",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
