rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is logged in
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper function to check if user is modifying their own document
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // Helper function to get user role
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    function isAdmin() {
      return isSignedIn() && (getUserRole() == 'admin' || request.auth.token.email.matches('.*admin.*'));
    }
    
    function isDesigner() {
      return isSignedIn() && (getUserRole() == 'designer' || isAdmin());
    }

    // User profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) || isAdmin();
    }

    // Products / 3D CAD models
    match /products/{productId} {
      allow read: if true;
      allow create: if isDesigner() || isAdmin();
      allow update, delete: if isDesigner() || isAdmin();
    }

    // Orders
    match /orders/{orderId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Custom design requests / messages
    match /customRequests/{requestId} {
      allow read, write: if isSignedIn();
    }
  }
}
