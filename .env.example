# ==========================================
# VCUBE — BIẾN MÔI TRƯỜNG (mẫu)
# ==========================================
# Sao chép rồi điền giá trị thật:  cp .env.example .env
# File .env KHÔNG được commit (đã gitignore) và không được chứa khoá thật.

# --- Client (an toàn để lộ ra bundle; RLS là cổng chặn) ---

# URL project Supabase.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Khoá publishable (bắt đầu bằng sb_publishable_…). An toàn cho client nhờ RLS.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Domain dùng cho auth redirect / link tự tham chiếu. Đây chỉ là giá trị ví dụ.
VITE_SITE_URL=http://localhost:3000

# --- SERVER ONLY — KHÔNG bao giờ lộ ra client ---

# Khoá secret (bắt đầu bằng sb_secret_…): BỎ QUA TOÀN BỘ RLS.
# Chỉ dùng ở script/backend phía server. TUYỆT ĐỐI không đặt trong `define` của Vite,
# không commit, không gửi xuống browser.
SUPABASE_SECRET_KEY=sb_secret_your-key-never-expose

# ==========================================
# Legacy alias — sẽ gỡ ở T39
# Giữ để tương thích trong lúc chuyển đổi; vite.config.ts/scripts chấp nhận cả hai tên.
# ==========================================

# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Legacy alias cho SUPABASE_SECRET_KEY (script cũ vẫn đọc). Không expose ra client.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-never-expose

# APP_URL: legacy AI Studio (không còn được app dùng). Đây chỉ là giá trị ví dụ.
APP_URL="MY_APP_URL"
